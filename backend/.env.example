PORT=5000
NODE_ENV=development
JWT_SECRET=kernel0x_super_secret_ctf_jwt_key_2026
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
CTF_EVENT_URL=/ctf-portal

# =======================================================
# CTF COMPETITION ACCESS POLICY
# =======================================================
# Set to 'false' if you want instant registration access without requiring email OTP
# Set to 'true' to require 6-digit email verification before entering the CTF
REQUIRE_EMAIL_VERIFICATION=true

# =======================================================
# EMAIL DISPATCH CONFIGURATION (FOR MULTIPLE PARTICIPANTS)
# =======================================================
# For low volume / testing with Gmail:
# 1. Enable 2-Step Verification on Google Account
# 2. Generate a 16-character App Password at https://myaccount.google.com/apppasswords
SMTP_SERVICE=gmail
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_character_app_password
SMTP_FROM="Kernel0X CTF <noreply@kernel0x.com>"

# For high-volume CTF events (Recommended: Brevo / SendGrid / Resend)
# Brevo offers 300 free emails/day without Google burst blocks:
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your_brevo_login
# SMTP_PASS=your_brevo_smtp_key
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
