PORT=5000
NODE_ENV=development
JWT_SECRET=kernel0x_super_secret_ctf_jwt_key_2026
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
CTF_EVENT_URL=/ctf-portal

# =======================================================
# EMAIL DISPATCH CONFIGURATION (GMAIL / OUTLOOK / SMTP)
# =======================================================
# To send real verification emails to participants' inboxes:
#
# If using Gmail:
# 1. Go to https://myaccount.google.com/apppasswords
# 2. Create an App Name (e.g. "Kernel0X CTF") and copy the 16-character password
# 3. Fill in your Gmail and that 16-character password below:
SMTP_SERVICE=gmail
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_character_app_password
SMTP_FROM="Kernel0X CTF <noreply@kernel0x.com>"

# If using custom SMTP host (Brevo, SendGrid, Mailgun, Outlook):
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
